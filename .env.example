DB_HOST=
DB_PORT=
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
AUTH_SECRET=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Opsional: Origin publik aplikasi & daftar email guru terverifikasi
NEXT_PUBLIC_APP_ORIGIN=https://kertamarga-bali.vercel.app
GURU_ALLOWED_EMAILS=

# Opsional: JSON array akun demo juri (dikirim lewat form panitia, bukan ditanam di repo)
DEMO_SEED_USERS_JSON=

# 9Router Multi-Provider & Failover Configuration
ROUTER_API_BASE=http://127.0.0.1:20128/v1
ROUTER_API_KEY=
ROUTER_COMBO_MODEL=ag/gemini-3-flash
ROUTER_MODEL=ag/gemini-3-flash
ROUTER_MODEL_FAST=ag/gemini-3-flash-agent
ROUTER_BACKUP_MODELS=ag/gemini-3-flash-agent,openrouter/openrouter/free
ROUTER_TOTAL_BUDGET_MS=5000

# Anti-Ban & Resiliency Safeguards
ROUTER_CACHE_ENABLED=true
ROUTER_CACHE_TTL_MS=7200000
ROUTER_COOLDOWN_MS=900000
ROUTER_JITTER_MIN_MS=80
ROUTER_JITTER_MAX_MS=300
ROUTER_MIN_DELAY_MS=650
GEMINI_MIN_DELAY_MS=1350
PROVIDER_429_COOLDOWN_MS=60000
