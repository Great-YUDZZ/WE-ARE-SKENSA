DB_HOST=
DB_PORT=
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
AUTH_SECRET=
GEMINI_API_KEY=

# 9Router Multi-Provider & Failover Configuration
ROUTER_API_BASE=http://127.0.0.1:20128/v1
ROUTER_API_KEY=
ROUTER_COMBO_MODEL=skensa-failover
ROUTER_MODEL=ag/gemini-3.8-flash-high
ROUTER_MODEL_FAST=ag/gemini-3.8-flash-low
ROUTER_BACKUP_MODELS=kr/auto,kr/deepseek-3.2,kr/claude-sonnet-4.5,openrouter/nvidia/nemotron-3.5-super-vl:free

# Anti-Ban & Resiliency Safeguards
ROUTER_CACHE_ENABLED=true
ROUTER_CACHE_TTL_MS=7200000
ROUTER_COOLDOWN_MS=900000
ROUTER_JITTER_MIN_MS=250
ROUTER_JITTER_MAX_MS=750
